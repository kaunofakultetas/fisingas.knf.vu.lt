services:

  # ------------------------------------------------------------
  #              Incoming/outgoing traffic endpoints
  # ------------------------------------------------------------
  fisingas-endpoint:
    container_name: fisingas-endpoint
    image: caddy:2.11-alpine
    user: 1000:1000
    read_only: true
    volumes:
      - ./endpoint/Caddyfile:/etc/caddy/Caddyfile:ro
    ports:
      - 80:80
    restart: unless-stopped

  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------






  # ------------------------------------------------------------
  #                   Phishing test services
  # ------------------------------------------------------------
  fisingas-vite:
    container_name: fisingas-vite

    # Pull from Docker Hub
    image: vuknf/fisingas-vite:latest

    # # Self-built
    # image: fisingas-vite
    # build:
    #   context: ./vite
    #   dockerfile: Dockerfile                                                # Prod
    #   # dockerfile: Dockerfile.dev                                            # Dev

    user: 1000:1000
    read_only: true                                                         # Prod
    # volumes:                                                                # Dev
    #   - ./vite/app:/app                                                     # Dev
    restart: unless-stopped


  fisingas-django:
    container_name: fisingas-django

    # Pull from Docker Hub
    image: vuknf/fisingas-django:latest

    # # Self-built
    # image: fisingas-django
    # build: ./django

    user: 1000:1000
    read_only: true
    environment:
      # - DJANGO_DEBUG=True                                                   # Dev
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
      - DATABASE_URL=postgres://fisingas:fisingas@fisingas-postgres:5432/fisingas
      - SLIDES_DIRECTORY=/slides
    tmpfs:
      - /tmp:uid=1000,gid=1000
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./_DATA/slides:/slides
      # - ./django:/app                                                       # Dev
    restart: unless-stopped


  fisingas-cron:
    container_name: fisingas-cron

    # Pull from Docker Hub
    image: vuknf/fisingas-cron:latest

    # # Self-built
    # image: fisingas-cron
    # build: ./cron

    user: root
    read_only: true
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock
    network_mode: none
    restart: unless-stopped


  fisingas-postgres:
    container_name: fisingas-postgres
    image: postgres:17-alpine
    user: 1000:1000
    read_only: true
    environment:
      - POSTGRES_DB=fisingas
      - POSTGRES_USER=fisingas
      - POSTGRES_PASSWORD=fisingas
      - PGDATA=/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fisingas -d fisingas"]
      interval: 5s
      timeout: 3s
      retries: 10
    tmpfs:
      - /tmp:uid=1000,gid=1000
      - /var/run/postgresql:uid=1000,gid=1000
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./_DATA/postgres:/var/lib/postgresql/data
    restart: unless-stopped

  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------









  # ------------------------------------------------------------
  #               Additional phishing test services
  # ------------------------------------------------------------
  fisingas-filebrowser-dropbox:
    container_name: fisingas-filebrowser-dropbox
    image: vuknf/filebrowser-noauth:latest
    user: 1000:1000
    read_only: false
    volumes:
      # Filebrowser Configuration
      - ./filebrowser/dropbox.json:/config/settings.json:ro

      # Filebrowser Root Directory
      - ./_DATA/dropbox:/data
    restart: unless-stopped


  fisingas-filebrowser-slides:
    container_name: fisingas-filebrowser-slides
    image: vuknf/filebrowser-noauth:latest
    user: 1000:1000
    read_only: false
    volumes:
      # Filebrowser Configuration
      - ./filebrowser/slides.json:/config/settings.json:ro

      # Filebrowser Root Directory
      - ./_DATA/slides:/data
    restart: unless-stopped

  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------













  # ------------------------------------------------------------
  #               Additional administration services 
  # ------------------------------------------------------------
  fisingas-dbgate:
    container_name: fisingas-dbgate
    image: dbgate/dbgate:7.2.3-alpine
    user: root
    read_only: true
    environment:
      WEB_ROOT: /dbgate

      BASIC_AUTH: 1
      LOGIN: dbgate
      PASSWORD: ${DBGATE_PASSWORD}

      CONNECTIONS: con1
      LABEL_con1: Fišingo Testas - DB
      SERVER_con1: fisingas-postgres
      PORT_con1: 5432
      USER_con1: fisingas
      PASSWORD_con1: fisingas
      DATABASE_con1: fisingas
      ENGINE_con1: postgres@dbgate-plugin-postgres
    restart: unless-stopped

  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------







  # ------------------------------------------------------------
  #                      Documentation services
  # ------------------------------------------------------------
  fisingas-swagger:
    container_name: fisingas-swagger
    image: swaggerapi/swagger-ui:v5.29.5
    user: 1000:1000
    read_only: false
    volumes:
      - ./swagger/swagger.yaml:/swagger.yaml:ro
    environment:
      - SWAGGER_JSON=/swagger.yaml
      - BASE_URL=/swagger
    restart: unless-stopped

  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------







